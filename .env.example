VITE_USE_MOCK=true
VITE_ENV=dev
VITE_API_BASE=/api

# MQTT Configuration — the modem-gateway hardware publishes to the HiveMQ public broker.
# NOTE: nothing in the backend loads this .env file (no python-dotenv). These vars must
# be set in the real environment — e.g. the Railway project's Variables tab.
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CLIENT_ID=dialog-alert-service
# Topics the backend SUBSCRIBES to (must match what the gateway publishes):
MQTT_TOPIC=devices/modem-gateway/alerts
MQTT_IMAGE_TOPIC=devices/modem-gateway/alerts/image
MQTT_STATUS_TOPIC=devices/modem-gateway/status
# Actuator command topics the backend PUBLISHES to are fixed:
#   dialog/actuators/signs/{station_id}/command
#   dialog/actuators/sirens/{station_id}/command

