# GIS Core Service (the main platform's GIS instance) - development settings for docker-compose.yml.
#
#   cp .env.example .env
#
# Replace every CHANGE_ME with a strong random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# .env is git-ignored. Never commit real credentials.

# --- PostgreSQL superuser (used only by the database container's first-start initialisation) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

# --- GIS databases and logins (created by db/init/20-gis-roles-and-databases.sh) ---
GIS_DB_NAME=gis
GIS_TEST_DB_NAME=gis_test
# Owns the schemas; used only by Alembic migrations.
GIS_DB_MIGRATOR_USER=gis_migrator
GIS_DB_MIGRATOR_PASSWORD=CHANGE_ME
# Least-privilege runtime login used by the API.
GIS_DB_APP_USER=gis_app
GIS_DB_APP_PASSWORD=CHANGE_ME

# --- API ---
GIS_ENV=development
GIS_LOG_LEVEL=INFO
# json (default for deployments) or console (readable locally)
GIS_LOG_FORMAT=console
# Comma-separated browser origins allowed to call the API directly.
GIS_CORS_ALLOW_ORIGINS=http://localhost:5174
# Accepted positions: min_lon,min_lat,max_lon,max_lat (WGS84).
# Default = EPSG:5235 area of use (Sri Lanka onshore) widened by 0.2 degrees for nearshore waters.
# The database enforces this envelope on every stored geometry, so the setting may narrow it, not widen it.
GIS_SERVICE_AREA_BBOX=79.44,5.66,82.15,10.08

# --- The platform's organisation ---
# The GIS runs as an instance of the main platform, which owns users and sign-in; the GIS checks no
# credentials. Requests act for this tenant unless they name another in the X-GIS-Tenant-Id header. The
# migrate service registers it (python -m app.tools.register_tenant).
GIS_TENANT_ID=dialog-smart-alerts
GIS_TENANT_NAME=Dialog Smart Alerts

# --- Exports: one file per request, refused (not truncated) above this many features ---
GIS_EXPORT_MAX_FEATURES=10000

# --- Geo-context enrichment (metres, inclusive; device limit 0 turns the device lookup off).
#     The settlement and road radii also bound GET /geo/v1/reverse. ---
GIS_ENRICHMENT_SETTLEMENT_RADIUS_M=25000
GIS_ENRICHMENT_ROAD_RADIUS_M=10000
GIS_ENRICHMENT_DEVICE_RADIUS_M=5000
GIS_ENRICHMENT_DEVICE_LIMIT=5

# --- Host ports (bound to 127.0.0.1; the main platform uses 8000 and 5173) ---
GIS_DB_HOST_PORT=5434
GIS_API_HOST_PORT=8100
GIS_WEB_HOST_PORT=5174

# --- Hot reload on Docker Desktop (Windows/macOS) ---
# File-change events from the host do not reach containers there; set both to true if edits are not picked up.
WATCHFILES_FORCE_POLLING=false
VITE_USE_POLLING=false

# --- Map client (docs/frontend/map-client.md) ---
# MapLibre style of the basemap. The pipeline builds it into data/basemap/<release>/ (PMTiles, style, glyphs),
# which the dev server serves at /basemap (docs/reference-data/pipeline.md). Leave empty for the neutral
# background when data/basemap/ref-2026.09-dev has not been built or delivered.
VITE_BASEMAP_STYLE_URL=/basemap/ref-2026.09-dev/style.json
# Several basemaps to switch between, as JSON: [{"id":"osm","label":"OpenStreetMap","styleUrl":"https://..."}]
VITE_BASEMAPS=
# Tenant whose operational data (devices, sites, geofences, events) the map reads (empty: GIS_TENANT_ID).
VITE_TENANT_ID=
# How much of a layer to read per viewport, and how many pages to follow.
VITE_FEATURE_LIMIT=500
VITE_MAX_FEATURE_PAGES=4
# The event window the map starts with, in hours (the API refuses more than 31 days).
VITE_EVENT_WINDOW_HOURS=24
# Re-read events on this interval in milliseconds; 0 leaves refreshing to the operator.
VITE_EVENT_REFRESH_INTERVAL_MS=0
